# Django Settings
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS Allowed Origins (comma-separated) - frontend domains that can access the API
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Allow Private Network Access (needed when frontend is public but API resolves to private IP)
# CORS_ALLOW_PRIVATE_NETWORK=False

# Rate Limiting (per-IP, protects image submission from abuse)
# RATE_LIMIT_ENABLE=True
# RATE_LIMIT_RATE=2/min
# RATE_LIMIT_EXCLUDE_PATHS=/health/,/api/v1/health-light/
# RATE_LIMIT_INCLUDE_PATHS=/api/v1/ocr/

# CSRF Trusted Origins for cross-origin requests (comma-separated)
# Add your frontend domain here to allow cross-origin requests
CSRF_TRUSTED_ORIGINS=https://rest-openlpr.computedsynergy.com

# Qwen3-VL API Configuration
QWEN_API_KEY=your-qwen-api-key-here
QWEN_BASE_URL=https://your-open-api-compatible-endpoint.com/v1
QWEN_MODEL=qwen3-vl-4b-instruct

# File Upload Settings
UPLOAD_FILE_MAX_SIZE=1048576
MAX_BATCH_SIZE=10

# Database Settings (optional - defaults to SQLite)
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Media Settings (optional - defaults to ./media for development, ./container-media for containers)
# MEDIA_PATH=/path/to/media/directory

# Prometheus metrics state file (optional - defaults to metrics_state.json beside the database)
# METRICS_FILE_PATH=/path/to/metrics_state.json

# Frontend Ports (docker compose only, optional)
# Grafana must not share SPA_PORT; both are published to the host.
# SPA_PORT=3000
# GRAFANA_PORT=3001
# PROMETHEUS_PORT=9090

# Email Settings (optional - for error notifications)
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password

# Local ONNX pipeline backend (PIPELINE_BACKEND=local|llm; default local)
# The default runs plate detection and OCR with in-process ONNX models instead of
# the API (~60ms per image instead of ~3600ms), which REQUIRES the model artifacts
# under PIPELINE_MODEL_DIR to be present. Rolling back is configuration-only: set
# PIPELINE_BACKEND=llm and redeploy. No migration, no data rewrite.
# The local backend's text accuracy is unmeasurable (the corpus carries no
# transcription labels), so it reads more plates than the LLM and also misreads
# some. Higher coverage is not higher accuracy. See AGENTS.md "Local ONNX Pipeline".
# PIPELINE_BACKEND=local
# Model artifacts are resolved relative to this directory (gitignored).
# PIPELINE_MODEL_DIR=model/plate
# PIPELINE_DETECTOR_MODEL=plate_yolox_tiny_640.onnx
# Detection input resolution is recall-critical: the corpus 10th-percentile plate
# is 36px tall, which only stays resolvable at 640. Do not lower for speed.
# PIPELINE_DETECTOR_INPUT_SIZE=640,640
# PIPELINE_DETECTOR_CONF_THRESHOLD=0.3
# PIPELINE_DETECTOR_NMS_IOU=0.45
# PIPELINE_LAYOUT_THRESHOLD=2.0
# PIPELINE_OCR_MODEL=plate_ocr_ppocrv5_mobile.onnx
# PIPELINE_OCR_DICT=plate_ocr_dict.json
# PIPELINE_OCR_BATCH_SIZE=8
# PIPELINE_OCR_CHARSET_PROFILE=alphanumeric
# Off by default: on this corpus, row splitting reads captions as a second line
# more often than it rescues genuinely stacked plates.
# PIPELINE_OCR_SPLIT_STACKED=False
# When rectification is off, OCR_CROP_PADDING_PX applies instead.
# PIPELINE_RECTIFY_ENABLED=True
# cpu | cuda | rocm. An unavailable provider falls back to CPU with a warning.
# ROCm is never required for contributors.
# PIPELINE_PROVIDER=cpu
# The project's sub-500ms target, and optional per-stage overrides.
# PIPELINE_LATENCY_BUDGET_SECONDS=0.5
# PIPELINE_STAGE_BUDGETS=detect_plate=0.4

# Detection pipeline settings
# PROCESSING_TIMEOUT_MINUTES=5
# MAX_RETRIES=2
# RETRY_BATCH_SIZE=5
# RETRY_INTERVAL_MINUTES=5
# RETRY_SCHEDULER_ENABLED=True
# RUN_SCHEDULER explicitly enables the scheduler (auto-detected under Gunicorn)

# Canary Configuration
CANARY_HEADER_NAME=X-Canary-Request
CANARY_HEADER_VALUE=true
CANARY_ENABLED=true

# SPA Frontend Settings (runtime, set via Docker environment)
# BACKEND_API_URL=http://localhost:8000
# NEXT_PUBLIC_UPLOAD_TIMEOUT=120000

# Prometheus URL (for availability graph proxy)
# PROMETHEUS_URL=http://prometheus:9090
