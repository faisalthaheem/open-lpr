# =============================================================================
# LlamaCpp + OpenLPR Environment Configuration
# =============================================================================

# =============================================================================
# HuggingFace Configuration
# =============================================================================
# Your HuggingFace access token (required for some models)
# Get it from: https://huggingface.co/settings/tokens
HF_TOKEN=your token goes here

# Model repository and file configuration
MODEL_REPO=unsloth/Qwen3-VL-4B-Instruct-GGUF
MODEL_FILE=Qwen3-VL-4B-Instruct-Q5_K_M.gguf
LLAMA_ARG_MMPROJ_URL=https://huggingface.co/unsloth/Qwen3-VL-4B-Instruct-GGUF/resolve/main/mmproj-BF16.gguf

# =============================================================================
# Django Settings
# =============================================================================
SECRET_KEY=django-insecure-change-me-in-production-use-a-strong-random-key
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,lpr.localhost,lpr-app
CORS_ALLOWED_ORIGINS=http://localhost:3000
# CORS_ALLOW_PRIVATE_NETWORK=False
# RATE_LIMIT_ENABLE=True
# RATE_LIMIT_RATE=2/min
# RATE_LIMIT_EXCLUDE_PATHS=/health/,/api/v1/health-light/
# RATE_LIMIT_INCLUDE_PATHS=/api/v1/ocr/
# CSRF_TRUSTED_ORIGINS=https://your-domain.com

# =============================================================================
# File Upload Settings
# =============================================================================
UPLOAD_FILE_MAX_SIZE=1048576
# Decoded-pixel ceiling, checked from the image header before decompression.
# UPLOAD_FILE_MAX_SIZE bounds bytes on disk, not memory: a flat-colour PNG
# compresses ~3000:1, so a 0.4MB upload can declare 144MP and cost 430MB of RAM.
# 40MP covers a 12MP phone photo with room. The detector letterboxes to 640x640,
# so more input resolution buys no accuracy. Set 0 to disable.
# UPLOAD_IMAGE_MAX_PIXELS=40000000
MAX_BATCH_SIZE=10

# =============================================================================
# Local ONNX Pipeline Backend
# =============================================================================
# local (default) or llm. The default runs plate detection and OCR with in-process
# ONNX models instead of the API, at ~60ms per image instead of ~3600ms. Rolling
# back is configuration-only: set PIPELINE_BACKEND=llm and redeploy. No migration,
# no data rewrite.
#
# The local backend is faster and detects more reliably than the LLM on the corpus,
# but its text accuracy is UNMEASURABLE (the corpus has no transcription labels), so
# it also misreads some plates it does find. Do not treat higher read coverage as
# higher accuracy. See AGENTS.md "Local ONNX Pipeline".
#
# PIPELINE_BACKEND=local
# Model artifacts are resolved relative to this directory (gitignored).
# PIPELINE_MODEL_DIR=/app/model/plate
# Artifact download. docker-entrypoint.sh downloads ~37MB into PIPELINE_MODEL_DIR
# on first boot and verifies checksums on every boot.
#
# IMPORTANT: mount ./model/plate as a PERSISTENT volume. Without one the
# directory lives in the container's writable layer and is lost on every
# container replacement, so the download repeats on each redeploy.
#
# Set false for airgapped installs that populate PIPELINE_MODEL_DIR elsewhere.
# PIPELINE_MODEL_DOWNLOAD=true
# Source and revision. The revision is pinned to a tag so a deployment version
# resolves to the same weights on every future redeploy.
# PIPELINE_MODEL_REPO=faisalthaheem/open-lpr-models
# PIPELINE_MODEL_REVISION=detector-2026.10.1
# PIPELINE_DETECTOR_MODEL=plate_yolox_tiny_640.onnx
# Detection input resolution is recall-critical: the corpus 10th-percentile plate
# is 36px tall, which only stays resolvable at 640. Do not lower it for speed.
# PIPELINE_DETECTOR_INPUT_SIZE=640,640
# PIPELINE_DETECTOR_CONF_THRESHOLD=0.3
# PIPELINE_DETECTOR_NMS_IOU=0.45
# PIPELINE_LAYOUT_THRESHOLD=2.0
# PIPELINE_OCR_MODEL=plate_ocr_ppocrv5_mobile.onnx
# PIPELINE_OCR_DICT=plate_ocr_dict.json
# PIPELINE_OCR_BATCH_SIZE=8
# PIPELINE_OCR_CHARSET_PROFILE=alphanumeric
# Off by default: on this corpus, row splitting reads a single-line plate's caption
# as a second line more often than it rescues genuinely stacked plates.
# PIPELINE_OCR_SPLIT_STACKED=False
# When rectification is off, OCR_CROP_PADDING_PX applies instead.
# PIPELINE_RECTIFY_ENABLED=True
# cpu | cuda | rocm. An unavailable provider falls back to CPU with a warning.
# CPU is the supported deployment target; ROCm is never required for contributors.
# PIPELINE_PROVIDER=cpu
# The project's sub-500ms target, plus optional per-stage overrides.
# PIPELINE_LATENCY_BUDGET_SECONDS=0.5
# PIPELINE_STAGE_BUDGETS=detect_plate=0.4

# =============================================================================
# Database Configuration
# =============================================================================
DATABASE_PATH=/app/data/db.sqlite3

# Prometheus metrics state persistence
METRICS_FILE_PATH=/app/metrics/metrics_state.json

# =============================================================================
# Detection Pipeline Settings
# =============================================================================
# PROCESSING_TIMEOUT_MINUTES=5
# MAX_RETRIES=2
# RETRY_BATCH_SIZE=5
# RETRY_INTERVAL_MINUTES=5
# RETRY_SCHEDULER_ENABLED=True
# RUN_SCHEDULER explicitly enables the scheduler (auto-detected under Gunicorn)

# =============================================================================
# Monitoring Configuration
# =============================================================================
# Prometheus URL (for availability graph proxy)
# PROMETHEUS_URL=http://prometheus:9090

# Grafana Configuration
# GRAFANA_PORT must differ from SPA_PORT (default 3000); both are published to the
# host, so equal values contend for the port and one service fails to start.
GRAFANA_PORT=3001
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# Traefik Configuration (optional - for production)
# TRAEFIK_DOMAIN=your-domain.com
# TRAEFIK_EMAIL=admin@your-domain.com

# =============================================================================
# Qwen3-VL API Configuration
# =============================================================================
# API configuration for connecting to the LlamaCpp inference service
QWEN_API_KEY=sk-llamacpp-local
#when using a remote Open API comptaible endpoint
# QWEN_BASE_URL=https://your-api-endpoint.io/v1
#When running the bundled llamacpp using CPU (default)
QWEN_BASE_URL=http://llamacpp-cpu:8000/v1
#When running the bundled llamacpp using AMD GPUs
# QWEN_BASE_URL=http://llamacpp-amd-vulkan:8000/v1
#When running the bundled llamacpp using Nvidia GPUs
# QWEN_BASE_URL=http://llamacpp-nvidia-cuda:8000/v1
QWEN_MODEL=Qwen3-VL-4B-Instruct

# =============================================================================
# Optional: Superuser Creation
# =============================================================================
# Uncomment and set these values to automatically create a Django superuser
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_EMAIL=admin@example.com
# DJANGO_SUPERUSER_PASSWORD=your-secure-password


# =============================================================================
# Production Settings (Uncomment for Production)
# =============================================================================
# ALLOWED_HOSTS=your-domain.com,www.your-domain.com
# DEBUG=False
# SECRET_KEY=generate-a-very-strong-random-key-here
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_EMAIL=admin@your-domain.com
# DJANGO_SUPERUSER_PASSWORD=use-a-very-strong-password

# =============================================================================
# SPA Frontend Settings (runtime)
# =============================================================================
# BACKEND_API_URL=http://lpr-app:8000
# NEXT_PUBLIC_UPLOAD_TIMEOUT=120000

# =============================================================================
# Traefik Router Host Configuration (Optional - will use defaults if not set)
# =============================================================================
# Uncomment and customize these variables to override default Traefik router rules
# LPR_APP_HOST=Host(`lpr.localhost`)
# TRAEFIK_HOST=Host(`traefik.localhost`)
# PROMETHEUS_HOST=Host(`prometheus.localhost`)
# GRAFANA_HOST=Host(`grafana.localhost`)
# BLACKBOX_HOST=Host(`blackbox.localhost`)
# CANARY_HOST=Host(`canary.localhost`)
# LLAMACPP_CPU_HOST=Host(`llamacpp-cpu.localhost`)
# LLAMACPP_AMD_VULKAN_HOST=Host(`llamacpp-amd-vulkan.localhost`)
# LLAMACPP_NVIDIA_CUDA_HOST=Host(`llamacpp-nvidia-cuda.localhost`)

